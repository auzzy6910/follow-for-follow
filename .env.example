# Convex deployment URL used by the React/Vite frontend.
# Copy this file to `.env.local` and fill in the value from your Convex dashboard
# (https://dashboard.convex.dev) or `npx convex dev` output.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# The following variables are NOT read by the frontend — they must be set on
# your Convex deployment itself (via `npx convex env set ...` or the dashboard)
# so Convex Auth can issue and verify JWTs:
#
#   SITE_URL          Where the frontend is served (e.g. http://localhost:5173)
#   JWT_PRIVATE_KEY   RSA private key for signing auth JWTs
#   JWKS              Public JWKS used to verify auth JWTs
#
# Generate JWT_PRIVATE_KEY and JWKS by running the script documented in the
# README under "Authentication".
